# Copy to .env and fill in. Never commit .env or ./auth

# --- Prayer time ---
CITY=Cairo
COUNTRY=Egypt
METHOD=5
TIMEZONE=Africa/Cairo
PRAYER=Maghrib
DELAY_MINUTES=30
WINDOW_MINUTES=15

# --- Images: Supabase (recommended — you finished this step) ---
IMAGE_SOURCE=supabase
IMAGE_EXT=jpg
MAX_IMAGES=999
# Folder inside the repo / bucket / Cloudinary, where 1.jpg ... 999.jpg live
IMAGE_FOLDER=quotes

# GitHub — only if IMAGE_SOURCE=github
GITHUB_OWNER=your-github-username
GITHUB_REPO=quotes
GITHUB_BRANCH=main

# Supabase — only if IMAGE_SOURCE=supabase
# Create a PUBLIC bucket (e.g. quotes), upload 1.jpg ... 999.jpg into quotes/
# Example URL: https://xyzcompany.supabase.co/storage/v1/object/public/quotes/quotes/1.jpg
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_BUCKET=quotes

# Supabase state (optional, but recommended if you run in 2 places)
# Run supabase/schema.sql in Supabase > SQL Editor first.
# Use the SERVICE ROLE key (server only, never in a browser / public repo).
# It MUST start with eyJ... (legacy service_role JWT) or sb_secret_...
# Do NOT use the Postgres password or the Storage S3 secret — Supabase will answer 401 Invalid API key.
# If these two are set, lastIndex/lastSentDate live in Postgres, not state.json.
# If they are not set, the bot uses local state.json.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — only if IMAGE_SOURCE=cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_FOLDER is still accepted as an alias for IMAGE_FOLDER

# --- WhatsApp group ---
# Get it with: npm run list-groups
# Looks like: 120363123456789012@g.us
GROUP_JID=120363000000000000@g.us

# Optional: for pairing-code login instead of QR scan.
# Your WhatsApp number in international format, no + or spaces. Example Egypt: 201001234567
PHONE_NUMBER=

# Caption used when there is no entry for that image number in captions.json
# Placeholders — the bot replaces them every day:
# {n} = image number, {date} = today in Cairo, {tomorrow} = tomorrow's date
# {nextDay} / {nextDayAr} = tomorrow's day name in Arabic, e.g. الخميس
# {nextDayEn} = tomorrow's day name in English, e.g. Thursday
# {fridayLine} = Friday text if tomorrow is Friday, otherwise empty
# Example: if today is Wednesday, {nextDayAr} becomes الخميس.
#          if today is Thursday, {nextDayAr} becomes الجمعة and the Friday line is added.
CAPTION_TEMPLATE=تقبل الله منا ومنكم 🌙
# Put {nextDayAr} in your static text where you want the next day's name, e.g.:
# CAPTION_TEMPLATE=أذكار المساء 🌙
# غداً {nextDayAr} بإذن الله

# Friday line — added as a NEW line at the end, ONLY when tomorrow is Friday.
# If your caption already contains {fridayLine}, it is placed there instead, not added twice.
FRIDAY_TEXT=جمعة مباركة 🌙

# --- Vercel (optional) ---
# Shared secret for /api/check — set the same value in Vercel env vars.
# Then call: https://your-app.vercel.app/api/check?secret=YOUR_SECRET
CRON_SECRET=
